# 定义编译器
FC = mpiifort

# 定义编译选项
FFLAGS = -O2 -qopenmp
 

# 定义目标文件
OBJS = MAIN.o READ_AND_SET.o MPIBAL.o LINKS.o FLIP.o CAL_HAMILTONIAN.o

# 默认目标，生成可执行文件
all: SCI.out

# 生成可执行文件
SCI.out: $(OBJS)
	$(FC) $(FFLAGS) $(OBJS) -o SCI.out -qmkl=parallel

# 编译每个源文件为目标文件
MAIN.o: MAIN.f90
	$(FC) $(FFLAGS) -c MAIN.f90

MPIBAL.o: MPIBAL.f90
	$(FC) $(FFLAGS) -c MPIBAL.f90

LINKS.o: LINKS.f90
	$(FC) $(FFLAGS) -c LINKS.f90

FLIP.o: FLIP.f90
	$(FC) $(FFLAGS) -c FLIP.f90

READ_AND_SET.o: READ_AND_SET.f90
	$(FC) $(FFLAGS) -c READ_AND_SET.f90

CAL_HAMILTONIAN.o: CAL_HAMILTONIAN.f90
	$(FC) $(FFLAGS) -c CAL_HAMILTONIAN.f90

# 清理生成的目标文件和可执行文件
clean:
	rm -f $(OBJS) SCI.out
